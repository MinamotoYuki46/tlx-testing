# URL dasar aplikasi
BASE_URL=https://tlx.toki.id

# Timeout (detik)
WAIT_TIMEOUT=10

# Akun dummy untuk pengujian login
VALID_USERNAME=
VALID_PASSWORD=

# Slug valid untuk pengujian — sesuaikan dengan konten TLX TOKI saat ini
VALID_PROBLEM_SLUG=problems/arkavidia-10-cp-penyisihan/B
VALID_CONTEST_SLUG=contests/troc-43
VALID_COURSE_SLUG=courses/competitive-1

# Slug tidak valid (sengaja salah untuk negative test)
INVALID_PROBLEM_SLUG=problems/xxxxxxxxxxx-invalid-999
INVALID_CONTEST_SLUG=contests/xxxxxxxxxxx-invalid-999
INVALID_COURSE_SLUG=courses/xxxxxxxxxxx-invalid-999

# Mode headless: true = tidak tampilkan browser, false = tampilkan browser
HEADLESS=true
